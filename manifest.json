{
  "manifest_version": 3,
  "name": "EN Gloss Reader",
  "version": "0.1.0",
  "description": "日本語ページを英訳し、難語に日本語訳を添える英語学習向け拡張。Chrome内蔵Gemini Nanoでローカル処理、外部送信ゼロ。",
  "minimum_chrome_version": "140",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "EN Gloss Reader",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
